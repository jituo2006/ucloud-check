{
  "name": "ucloud-check",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:monitor": "eslint src/MonitoringSettings.tsx public/background.js public/monitor relay tests cloudflare",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "relay": "node --env-file=relay/.env relay/server.mjs",
    "relay:init": "node relay/init.mjs",
    "relay:demo": "node relay/server.mjs --demo",
    "cf:init": "node cloudflare/init.mjs",
    "cf:import-timetable": "node --env-file=cloudflare/.dev.vars cloudflare/import-timetable.mjs",
    "bark:test": "node --env-file=cloudflare/.dev.vars cloudflare/test-bark.mjs",
    "cf:dev": "wrangler dev --config cloudflare/wrangler.toml",
    "cf:check": "wrangler deploy --dry-run --outdir .wrangler/check --config cloudflare/wrangler.toml",
    "cf:db:local": "wrangler d1 migrations apply DB --local --config cloudflare/wrangler.toml"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.87.1",
    "@douyinfe/semi-icons-lab": "^2.87.1",
    "@douyinfe/semi-ui": "^2.87.1",
    "@tailwindcss/vite": "^4.1.16",
    "axios": "^1.13.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "tailwind": "^4.0.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "wrangler": "^4.158.0"
  }
}
